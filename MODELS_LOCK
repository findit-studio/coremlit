# CI model-cache key (.github/workflows/ci.yml, job `model-tests`, and
# .github/workflows/coverage.yml, job `coverage-models`, which SHARE the entry).
# actions/cache keys on the hash of this file and of MODELS_LOCK.d/: bump
# `cache-epoch` (or pin different revisions) to force a re-download.
#
# This file is CONSUMED, not decorative: `.github/actions/stage-models/stage.sh`
# — the ONE parser, which both workflows stage through — reads the tables below
# (small sed/awk block, no TOML crate; see that file's header) to build every
# `hf download` command, including `--revision` and `--local-dir`. Editing a repo
# name, selector, revision or destination here changes what CI actually downloads
# next run, exactly like editing any other lock file.
#
# EVERY TABLE CARRIES A `kit`, AND THE KIT IS HOW CI SELECTS IT. ci.yml runs
# ONE SHARD PER KIT — a separate parallel job with its own cache, its own
# download subset, its own checksum verification, its own gates and its own
# fp16 sweep — and each leg stages the tables whose `kit` equals its own. Table
# ORDER ACROSS kits is therefore NOT load-bearing any more: tables may be
# reordered, appended, or regrouped freely as long as each keeps its `kit`.
# (Order WITHIN the `speaker` kit still is — see the ORDER box below.)
#
# The old index-selected parser is gone, and so is the `table_count` tripwire
# that guarded it. Two checks replace it, and between them they still refuse
# every way a table can go silently unread:
#
#   - ci.yml's download step fails if ANY table lacks a `kit`, and fails if
#     the shard's own kit matches NO table (which would otherwise leave a
#     shard downloading nothing and gating a bare checkout).
#   - the hermetic `ci_shards_every_kit_in_the_lock` gate in
#     coremlit/tests/whisper/models_lock.rs fails if a kit named here
#     has no shard in ci.yml's matrix, or a shard names a kit no table
#     defines. That is the cross-shard half no single shard can see, and it
#     runs in the modelless `features` job on every PR.
#
# ###########################################################################
# # ORDER WITHIN THE `speaker` KIT IS AN ARTIFACT-CORRECTNESS INVARIANT.     #
# #                                                                         #
# # The two `kit = "speaker"` tables BOTH download into `Models/speakerkit/`,#
# # and they BOTH publish files named `pyannote_segmentation.mlmodelc/` and  #
# # `wespeaker.mlmodelc/`. The second download OVERWRITES the first, so the  #
# # LAST speaker table to run decides which bytes the shipping pipeline gets.#
# # The shard's download loop walks its kit's tables in the order they       #
# # appear HERE, so this file's order is what picks the winner.              #
# #                                                                         #
# # FluidInference is the BASE layer: seven of the nine staged bundles come  #
# # from it and nothing else publishes them, and it also carries PRE-REPAIR  #
# # copies of the other two. FinDIT-Studio is the OVERLAY: those other two,  #
# # as the issue-#15 fp16-guard-repaired re-conversions, and they MUST WIN.  #
# #                                                                         #
# # Swap those two tables and CI silently stages the pre-repair              #
# # segmentation graph — whose inert `log(epsilon = 0)` saturates            #
# # `segments` to −45440 on the default ANE placement — and the pre-repair   #
# # embedder, whose pooling guards vanish in fp16. Both are                  #
# # contract-identical and pass every load/shape test. Only bytes tell them  #
# # apart, which is why ci.yml's "Verify speakerkit overlay" step hashes     #
# # both graphs against the pins in                                          #
# # coremlit/tests/speaker/model_io.rs BEFORE any gate runs, and      #
# # fails the job naming this ordering as the cause.                        #
# ###########################################################################
#
# LOUD FOLLOW-UP: `revision = "main"` on the two whisper tables is a MOVING
# target, not a real lock — CI can still download different upstream bytes
# on two runs of an unchanged MODELS_LOCK if `main` moves between them.
# Pinning immutable, content-addressed commit hashes for those two repos is
# a deliberate user follow-up: it requires live network access (`hf api ...`
# or the HF web UI) to look up each repo's current commit SHA. Until that
# lands, treat `cache-epoch` bumps as the only reliable way to force a
# fresh, verified download of them. Every other table is NOT in that state:
# each pins an immutable commit SHA. Of those, granite, siglip, ced, clap and
# the FinDIT-Studio speakerkit artifacts additionally ship a
# `CHECKSUMS.sha256` that ci.yml verifies the downloaded bytes against (and
# that stage.sh requires to be ON DISK wherever a selector or a manifest names
# it — coremlit #147 round 2: it is excluded from every DIGEST check, so only a
# presence check can notice it missing);
# FluidInference's repo ships NO checksum file, so ITS manifest is one this
# repository generated over the staged tree at the pinned revision
# (`MODELS_LOCK.d/speakerkit@1ed7a66….sha256`), and the gates read their
# expected digests from it; it is covered additionally by the
# `tests/fp16_guards.rs` graph sweep, which reads every staged `model.mil` and
# pins its guard sites in both directions. The lid repo is in the same position
# for a different reason — it publishes digests, but in an
# `artifact_manifest.json` that `shasum -c` cannot read — and is covered the
# same way. See its table, and the MANIFEST box above.
#
# ###########################################################################
# # EVERY GLOBBED TABLE COMMITS A FILE MANIFEST: coremlit #139.             #
# #                                                                        #
# # `MODELS_LOCK.d/<vendor_dir>@<revision>.sha256`, one per table whose     #
# # selector is an `include` glob at an immutable revision. Lines are       #
# # `<64 lowercase hex><two spaces><path relative to this table's           #
# # local-dir>` and NOTHING else — no comments, no blank lines, no header.  #
# # The FILE NAME carries the revision, which is the whole mechanism: bump  #
# # a `revision` below without regenerating the manifest and the lookup     #
# # finds nothing, so the check reds by construction rather than by         #
# # somebody remembering.                                                   #
# #                                                                        #
# # WHAT IT IS FOR. `coremlit/tests/model_licences.rs` asks "does every     #
# # file CI stages have a licence row". Until #139 it could only ask that   #
# # of a `files` table, because a glob's contents "exist only after a       #
# # download" — so nine of the ten tables here were checked against the     #
# # rows that happened to exist, and a bundle a glob staged with NO row was #
# # never discovered. The manifest is that missing enumeration, and         #
# # committing it is what makes the check hermetic. The per-kit `model_io`  #
# # gates read their expected digests from the same file, so there is one   #
# # copy of "which bytes this artifact is" rather than three.               #
# #                                                                        #
# # WHERE EACH COMES FROM, and the transformation applied:                  #
# #                                                                        #
# #   table                        source          paths                    #
# #   ---------------------------  --------------  ---------------------    #
# #   FinDIT-Studio/speakerkit     CHECKSUMS.sha256  VERBATIM               #
# #   FinDIT-Studio/clapkit        CHECKSUMS.sha256  VERBATIM               #
# #   FinDIT-Studio/embedkit       CHECKSUMS.sha256  + `granite-97m-multilingual-r2/`
# #   FinDIT-Studio/siglip2-naflex CHECKSUMS.sha256  + `siglip2-base-patch16-naflex-512/`
# #   FinDIT-Studio/cedkit         CHECKSUMS.sha256  + `ced-tiny/ced_tiny.mlmodelc/`, plus
# #                                                  the staged `ced-tiny/MANIFEST.json`,
# #                                                  which upstream's list omits
# #   FinDIT-Studio/redimnetkit    CHECKSUMS.sha256  + `redimnet_b5.mlmodelc/`
# #   FluidInference/speaker-dia   GENERATED         `shasum -a 256` over the staged tree
# #   aufklarer/SpeechBrain-ECAPA  GENERATED         `shasum -a 256` over the staged tree
# #                                                                        #
# # The two GENERATED ones are the repos that ship no `shasum -c`-readable  #
# # digest list at all (see their tables). The prefix added to the middle   #
# # four is exactly each shard's `checksum-dir` relative to its `local-dir`:#
# # upstream's file sits beside what it digests, and the register needs     #
# # every path relative to the same root.                                   #
# #                                                                        #
# # A manifest lists every file its table stages, with ONE structural       #
# # exception: the table's own `CHECKSUMS.sha256`. No digest list can carry #
# # its own digest — speakerkit's tries, and records the digest of an EMPTY #
# # file doing it — so it is excused by name in the licence register.       #
# #                                                                        #
# # `.github/actions/stage-models/stage.sh` verifies all of this against    #
# # the DOWNLOADED bytes on every run of every shard, in both directions,   #
# # and refuses a manifest for a table on `revision = "main"`.              #
# ###########################################################################
#
# A TABLE ON `revision = "main"` HAS NO MANIFEST and cannot have one; it is
# the one table the licence register's direction 1 cannot enumerate, and it
# NAMES it rather than skipping quietly
# (`direction_one_covers_every_table_but_the_one_on_a_moving_revision`). That
# is a second reason to land the LOUD FOLLOW-UP above.
# 2 (coremlit #147 round 2): every entry under epoch 1 was saved by ci.yml's
# retired inline `hf download` loop, which bypassed stage.sh's per-table manifest
# pass — the only place an overlaid table's own bytes still exist to be checked
# against its own manifest. `verify` mode cannot tell such a tree from a good
# one, so those entries must not be restorable: bumping the epoch is what makes
# "a tree under this key was produced by a download that passed the per-table
# pass" true rather than aspirational.
cache-epoch = 2

